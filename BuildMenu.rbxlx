<roblox xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Workspace" referent="RBX1"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool></Properties><Item class="Part" referent="RBX2"><Properties><string name="Name">Baseplate</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>0</X><Y>-2</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>512</X><Y>4</Y><Z>512</Z></Vector3><Color3uint8 name="Color3uint8">4284126800</Color3uint8><token name="Material">1280</token><token name="shape">1</token><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item><Item class="Part" referent="RBX3"><Properties><string name="Name">BuildArea</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>0</X><Y>0.5</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="size"><X>96</X><Y>1</Y><Z>96</Z></Vector3><Color3uint8 name="Color3uint8">4291677650</Color3uint8><token name="Material">816</token><token name="shape">1</token><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item><Item class="SpawnLocation" referent="RBX4"><Properties><string name="Name">SpawnLocation</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>0</X><Y>0.5</Y><Z>-56</Z><R00>-1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>-1</R22></CoordinateFrame><Vector3 name="size"><X>12</X><Y>1</Y><Z>12</Z></Vector3><Color3uint8 name="Color3uint8">4285429895</Color3uint8><token name="Material">272</token><token name="shape">1</token><token name="TopSurface">0</token><token name="BottomSurface">0</token><int name="Duration">0</int></Properties></Item></Item><Item class="Lighting" referent="RBX5"><Properties><string name="Name">Lighting</string><token name="Technology">4</token><float name="ClockTime">14</float><float name="Brightness">2</float><bool name="GlobalShadows">true</bool></Properties></Item><Item class="ReplicatedStorage" referent="RBX6"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX7"><Properties><string name="Name">BuildMenu</string></Properties><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Catalog</string><ProtectedString name="Source">-- Reads the parts you can place from ReplicatedStorage.BuildParts.
--
--   BuildParts
--     Walls            &lt;- a Folder is a tab in the menu
--       Brick Wall     &lt;- a Model (or a single Part) is a card in that tab
--
-- Optional attributes (Properties window &gt; Attributes &gt; +):
--   on a tab folder   Order (number, lower comes first), Floor (true: everything in it is a floor tile)
--   on a model        DisplayName (text on the card), Order (number), Floor (true: a floor tile)
-- Floor tiles lie flat and only bump into other floor tiles, so walls and furniture can stand on them.
-- Parts straight inside BuildParts (not in a folder) go in an "Other" tab.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(script.Parent.Config)

local Catalog = {}

local OTHER = "Other"
local measured = setmetatable({}, { __mode = "k" }) -- [model] = its entry, worked out once

local function partsFolder()
	return ReplicatedStorage:WaitForChild(Config.PartsFolder)
end

local function usable(thing)
	if thing:IsA("BasePart") then
		return true
	end
	return thing:IsA("Model") and thing:FindFirstChildWhichIsA("BasePart", true) ~= nil
end

local function orderOf(thing)
	local order = thing:GetAttribute("Order")
	return type(order) == "number" and order or math.huge
end

local function sorted(a, b)
	if a.order ~= b.order then
		return a.order &lt; b.order
	end
	return a.name &lt; b.name
end

-- The menu entry for one model: its name, which tab it's in, and its size.
function Catalog.entry(model, tab)
	local entry = measured[model]
	if entry then
		return entry
	end
	local box, size
	if model:IsA("BasePart") then
		box, size = model.CFrame, model.Size
	else
		box, size = model:GetBoundingBox()
	end
	local bottom = box * CFrame.new(0, -size.Y / 2, 0)
	local tabName = tab and tab.Name or OTHER
	entry = {
		id = tabName .. "/" .. model.Name,
		name = model:GetAttribute("DisplayName") or model.Name,
		tab = tabName,
		order = orderOf(model),
		model = model,
		size = size,
		offset = bottom:ToObjectSpace(model:GetPivot()), -- the model's pivot, seen from its bottom centre
		floor = model:GetAttribute("Floor") == true or (tab ~= nil and tab:GetAttribute("Floor") == true),
	}
	measured[model] = entry
	return entry
end

-- Every tab with its parts, in menu order: { { name, items = { entry, ... } }, ... }
function Catalog.tabs()
	local tabs = {}
	local loose = {}
	for _, child in ipairs(partsFolder():GetChildren()) do
		if child:IsA("Folder") then
			local tab = { name = child.Name, order = orderOf(child), items = {} }
			for _, model in ipairs(child:GetChildren()) do
				if usable(model) then
					table.insert(tab.items, Catalog.entry(model, child))
				end
			end
			if #tab.items &gt; 0 then
				table.insert(tabs, tab)
			end
		elseif usable(child) then
			table.insert(loose, Catalog.entry(child, nil))
		end
	end
	if #loose &gt; 0 then
		table.insert(tabs, { name = OTHER, order = math.huge, items = loose })
	end
	table.sort(tabs, sorted)
	for _, tab in ipairs(tabs) do
		table.sort(tab.items, sorted)
	end
	return tabs
end

-- The entry for an id like "Walls/Brick Wall", or nil if there's no such part.
function Catalog.find(id)
	if type(id) ~= "string" then
		return nil
	end
	local tabName, name = string.match(id, "^(.-)/(.+)$")
	if not tabName then
		return nil
	end
	local root = partsFolder()
	local tab = root:FindFirstChild(tabName)
	local model
	if tab and tab:IsA("Folder") then
		model = tab:FindFirstChild(name)
	elseif tabName == OTHER then
		tab = nil
		model = root:FindFirstChild(name)
	end
	if model and usable(model) then
		return Catalog.entry(model, tab)
	end
	return nil
end

return Catalog
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">Config</string><ProtectedString name="Source">-- Build menu settings. Change these to make the menu your own.

local Config = {}

-- Where things live
Config.PartsFolder = "BuildParts" -- ReplicatedStorage.BuildParts: a folder per menu tab, a Model per part
Config.AreaName = "BuildArea" -- you can build on top of any part in Workspace with this name
Config.PlacedFolder = "PlacedParts" -- placed parts go into Workspace.PlacedParts

-- Placing
Config.GridSize = 2 -- studs per grid square
Config.FloorLift = 0.05 -- floor tiles stick up this far out of the build area, so nothing flickers
Config.MaxPartsPerPlayer = 300
Config.AnchorPlacedParts = true -- anchor every placed part so nothing falls over
Config.RemovePartsOnLeave = true -- a player's parts go when they leave
Config.RequestsPerSecond = 8 -- how fast one player may place or delete

-- Keys (PC). Phones and tablets get buttons instead.
Config.Keys = {
	Toggle = Enum.KeyCode.B, -- open / close the menu
	Rotate = Enum.KeyCode.R,
	Delete = Enum.KeyCode.X, -- delete mode on / off
	Stop = Enum.KeyCode.Q, -- stop placing or deleting
}

-- Colours and font
Config.Theme = {
	Panel = Color3.fromRGB(28, 30, 38),
	Card = Color3.fromRGB(46, 49, 61),
	Text = Color3.fromRGB(240, 240, 245),
	Muted = Color3.fromRGB(165, 170, 185),
	Accent = Color3.fromRGB(255, 176, 59),
	Good = Color3.fromRGB(90, 220, 120),
	Bad = Color3.fromRGB(235, 80, 70),
	Font = Enum.Font.GothamBold,
}

return Config
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">Grid</string><ProtectedString name="Source">-- Grid maths shared by your screen (where the ghost goes) and the server (where the part really goes),
-- so both always agree.

local Config = require(script.Parent.Config)

local Grid = {}

-- True when `part` is a build area: a part in Workspace named Config.AreaName.
function Grid.isArea(part)
	return typeof(part) == "Instance"
		and part:IsA("BasePart")
		and part.Name == Config.AreaName
		and part:IsDescendantOf(workspace)
end

-- How many grid squares a part covers across (x) and deep (z) after `turns` quarter turns.
function Grid.cells(entry, turns)
	local size = Config.GridSize
	local x = math.max(1, math.ceil(entry.size.X / size - 0.01))
	local z = math.max(1, math.ceil(entry.size.Z / size - 0.01))
	if turns % 2 == 1 then
		x, z = z, x
	end
	return x, z
end

-- Snaps a spot on a build area to the grid and works out everything about putting `entry` there.
-- x and z are studs from the area's centre, in the area's own directions (so turned areas work too).
-- Returns:
--   x, z          the snapped spot (this is what the client sends the server)
--   pivot         the CFrame to PivotTo the model to
--   ground        a CFrame on the area's top surface under the middle of the part
--   box, boxSize  the space the part takes up
--   inside        true when all of it is on the area
function Grid.solve(area, entry, x, z, turns)
	local size = Config.GridSize
	local cellsX, cellsZ = Grid.cells(entry, turns)
	local half = area.Size / 2
	-- the part's corner goes on a grid line, counted from the area's corner
	local minX = math.floor((x - cellsX * size / 2 + half.X) / size + 0.5) * size - half.X
	local minZ = math.floor((z - cellsZ * size / 2 + half.Z) / size + 0.5) * size - half.Z
	local maxX, maxZ = minX + cellsX * size, minZ + cellsZ * size
	local midX, midZ = (minX + maxX) / 2, (minZ + maxZ) / 2
	local height = entry.size.Y
	-- floor tiles sink into the area until only Config.FloorLift sticks out; everything else stands on top
	local baseY = half.Y + (entry.floor and Config.FloorLift - height or 0)
	local bottom = area.CFrame * CFrame.new(midX, baseY, midZ) * CFrame.Angles(0, turns * math.pi / 2, 0)
	local edge = 0.001
	return {
		x = midX,
		z = midZ,
		pivot = bottom * entry.offset,
		ground = area.CFrame * CFrame.new(midX, half.Y, midZ),
		box = area.CFrame * CFrame.new(midX, baseY + height / 2, midZ),
		boxSize = Vector3.new(cellsX * size, height, cellsZ * size),
		inside = minX &gt;= -half.X - edge and maxX &lt;= half.X + edge and minZ &gt;= -half.Z - edge and maxZ &lt;= half.Z + edge,
	}
end

-- The placed model (a child of the PlacedParts folder) that `part` belongs to, or nil.
function Grid.placedRoot(part, placed)
	local thing = part
	while thing and thing.Parent ~= placed do
		thing = thing.Parent
	end
	return thing
end

-- True when nothing already placed is in the way of `spot`. Floor tiles only bump into floor tiles and
-- everything else only into everything else, so walls and furniture can stand on floors.
function Grid.isFree(spot, entry, placed)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { placed }
	-- a little smaller than the squares, so parts can stand right next to each other
	local inside = spot.boxSize - Vector3.new(0.1, 0.1, 0.1)
	for _, part in ipairs(workspace:GetPartBoundsInBox(spot.box, inside, params)) do
		local thing = Grid.placedRoot(part, placed)
		if thing and (thing:GetAttribute("Floor") == true) == entry.floor then
			return false
		end
	end
	return true
end

return Grid
